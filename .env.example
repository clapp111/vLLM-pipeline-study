# cp .env.example .env 후 값 조정. docker compose 가 자동으로 읽음.

# VLLM_IMAGE: vLLM 도커 이미지. latest 는 CUDA 13 요구 → 드라이버가 낮으면(예: 노트북 CUDA 12.7)
#   CUDA 12.4 기반 태그로 고정. v0.8.5.post1 = CUDA 12.4 + Qwen3 지원. (prod 최신 드라이버면 latest)
# VLLM_MODEL: vLLM 서빙 모델 (dev: HF ID / prod 오프라인: /models/<name>)
#   Qwen/Qwen3-4B-AWQ : INT4 ~2.5GB, 6GB 적재 확인, 분류 정확도 양호 (기본값)
#   Qwen/Qwen3-0.6B   : FP16 ~1.2GB, 초경량 파이프라인 검증용 (정확도는 낮음, 이 경우 QUANTIZATION 비움)
# VLLM_SERVED_NAME: vLLM --served-model-name (litellm config 의 백엔드명과 일치)
# VLLM_QUANTIZATION: 양자화 방식 (AWQ 모델은 awq, FP16 모델이면 비워둠)
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=Qwen/Qwen3-4B-AWQ
VLLM_SERVED_NAME=news-classifier
VLLM_QUANTIZATION=awq

# VLLM_GPU_MEM_UTIL: 전체 VRAM 대비 사용 비율 (노트북 6GB 는 0.85 권장, 12GB=0.25 → ~3GB)
# VLLM_MAX_MODEL_LEN: 최대 컨텍스트 길이 (분류는 짧아도 됨. 낮출수록 KV 캐시 절약)
# VLLM_EXTRA_ARGS: 추가 인자. 노트북 저VRAM 은 --enforce-eager 로 cudagraph 오버헤드 제거
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_MODEL_LEN=2048
VLLM_EXTRA_ARGS=--enforce-eager

# HF_TOKEN: HuggingFace 토큰 (gated 모델 아니면 비워둠)
# LITELLM_MASTER_KEY: litellm 프록시 마스터 키
HF_TOKEN=
LITELLM_MASTER_KEY=sk-1234

# MODELS_DIR: 오프라인 모델의 호스트 경로 (컨테이너 /models 로 마운트)
MODELS_DIR=./models

# --- FastAPI 앱(로컬 분류) → litellm 호출 설정 ---
# LLM_BASE_URL: litellm 게이트웨이 (로컬 docker compose 는 호스트 4000)
# LLM_API_KEY: litellm 마스터 키 (LITELLM_MASTER_KEY 와 동일)
# LLM_MODEL: litellm config.yaml 의 model_name 별칭
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=sk-1234
LLM_MODEL=news-classifier
